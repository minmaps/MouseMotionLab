<Window x:Class="MouseMotionLab.Capture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:glWpfControl="clr-namespace:OpenTK.Wpf;assembly=GLWpfControl"
        Title="MouseMotionLab"
        Width="1440"
        Height="900"
        MinWidth="1180"
        MinHeight="720"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Grid x:Name="RootLayout" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="HeaderPanel" Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.5*" />
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="0.7*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Label Content="Interface souris Raw Input" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="↻" Click="RefreshDevices_Click" Margin="8,0,0,0" />
                        <ComboBox x:Name="DeviceComboBox" DisplayMemberPath="DisplayName" />
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <Label Content="DPI déclaré" />
                    <TextBox x:Name="DpiTextBox" Text="800" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <Label Content="Polling nominal" />
                    <ComboBox x:Name="PollingComboBox" SelectedIndex="3">
                        <ComboBoxItem Content="125" />
                        <ComboBoxItem Content="250" />
                        <ComboBoxItem Content="500" />
                        <ComboBoxItem Content="1000" />
                        <ComboBoxItem Content="2000" />
                        <ComboBoxItem Content="4000" />
                        <ComboBoxItem Content="8000" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,12,0">
                    <Label Content="Sensibilité 3D (°/mm)" />
                    <TextBox x:Name="DisplayScaleTextBox" Text="1.25" />
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="ArmButton" Content="Armer  [Espace]" Background="#176F61" Click="Arm_Click" />
                    <Button x:Name="CancelButton" Content="Annuler  [Échap]" Click="Cancel_Click" />
                    <Button x:Name="ExcludeButton" Content="Exclure le dernier  [⌫]" Click="Exclude_Click" />
                </StackPanel>
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="5" Margin="0,12,0,0">
                    <TextBlock Text="Raccourci pour armer" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button x:Name="ArmingShortcutButton" Content="Espace" MinWidth="160"
                            IsEnabled="False" Click="ArmingShortcut_Click"
                            LostKeyboardFocus="ArmingShortcut_LostKeyboardFocus" />
                    <Button x:Name="ResetArmingShortcutButton" Content="Réinitialiser"
                            IsEnabled="False" Click="ResetArmingShortcut_Click" />
                    <TextBlock x:Name="ArmingShortcutHintText"
                               Text="Clique puis appuie sur une touche ou un bouton de souris · Ctrl, Alt et Maj possibles"
                               Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </WrapPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CaptureColumn" Width="3*" />
                <ColumnDefinition x:Name="SidebarColumn" Width="1.15*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="CapturePanel" Grid.Column="0" Background="#060B12" BorderBrush="#26384D" BorderThickness="1" CornerRadius="10" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <glWpfControl:GLWpfControl x:Name="GameViewport"
                                               ClipToBounds="True"
                                               Focusable="True"
                                               Render="GameViewport_OnRender"
                                               PreviewMouseDown="GameViewport_PreviewMouseDown" />

                    <Border IsHitTestVisible="False"
                            Background="#06000000"
                            BorderBrush="#182C40"
                            BorderThickness="0,0,0,1" />

                    <Canvas x:Name="TrajectoryOverlay"
                            IsHitTestVisible="False"
                            ClipToBounds="True">
                        <Polyline x:Name="TrajectoryLine"
                                  Stroke="#F04ED6B2"
                                  StrokeThickness="2.5"
                                  StrokeLineJoin="Round" />
                        <Ellipse x:Name="TrajectoryStartMarker"
                                 Width="7"
                                 Height="7"
                                 Fill="#EAF4FF"
                                 Stroke="#4ED6B2"
                                 StrokeThickness="1"
                                 Visibility="Collapsed" />
                        <Ellipse x:Name="EndpointMarker"
                                 Width="13"
                                 Height="13"
                                 Fill="#40231B0E"
                                 Stroke="#FFCE73"
                                 StrokeThickness="2"
                                 Visibility="Collapsed" />
                    </Canvas>

                    <Grid x:Name="CrosshairOverlay"
                          Width="46"
                          Height="46"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Ellipse x:Name="CrosshairRing"
                                 Width="12"
                                 Height="12"
                                 Stroke="#EAF4FF"
                                 StrokeThickness="1.5"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                        <Rectangle Width="2" Height="10" Fill="#EAF4FF" HorizontalAlignment="Center" VerticalAlignment="Top" />
                        <Rectangle Width="2" Height="10" Fill="#EAF4FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        <Rectangle Width="10" Height="2" Fill="#EAF4FF" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="2" Fill="#EAF4FF" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Ellipse Width="3" Height="3" Fill="#4ED6B2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18" Background="#D0101722" CornerRadius="7" Padding="12,8">
                        <StackPanel>
                            <TextBlock x:Name="CaptureStateText" Text="Initialisation…" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Raw Input pilote la caméra. Le clic gauche termine le flick armé."
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,3,0,0" />
                            <TextBlock x:Name="SceneOrientationText"
                                       Text="yaw 0.0° · pitch 0.0° · 0 FPS"
                                       Foreground="#6F879F"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="MouseLockHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="20"
                            Background="#DC101722"
                            BorderBrush="#38526D"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14,9"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="MouseLockHintText"
                                   Text="Clique dans la scène pour capturer la souris · Échap pour la libérer"
                                   Foreground="#D6E6F7" />
                    </Border>
                    <Button x:Name="FullScreenButton"
                            Panel.ZIndex="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="18"
                            Content="⛶  Plein écran  [F11]"
                            Click="FullScreen_Click" />
                </Grid>
            </Border>

            <ScrollViewer x:Name="SidebarPanel" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Dernier essai" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Endpoint" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="EndpointText" Text="—" FontSize="16" Margin="0,2,0,10" />
                                    <TextBlock Text="Durée" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="DurationText" Text="—" FontSize="16" Margin="0,2,0,10" />
                                    <TextBlock Text="Paquets" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="PacketCountText" Text="—" FontSize="16" Margin="0,2,0,10" />
                                    <TextBlock Text="Intervalle médian / max" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="IntervalText" Text="—" FontSize="16" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Distance parcourue" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="PathLengthText" Text="—" FontSize="16" Margin="0,2,0,10" />
                                    <TextBlock Text="Fréquence effective" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="EffectiveHzText" Text="—" FontSize="16" Margin="0,2,0,10" />
                                    <TextBlock Text="Statut" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="TrialStatusText" Text="—" FontSize="16" Margin="0,2,0,10" />
                                    <TextBlock Text="Pauses &gt; 8 ms" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock x:Name="PauseCountText" Text="—" FontSize="16" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Données" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Couverture direction / distance" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Text="Endpoints acceptés du dataset" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8" />
                            <Canvas x:Name="CoverageCanvas" Height="230" Background="#0A1018" ClipToBounds="True" />
                            <Button x:Name="SpeedCurvesButton"
                                    Content="Voir les courbes de vitesse"
                                    Margin="0,12,0,0"
                                    IsEnabled="False"
                                    Click="SpeedCurves_Click" />
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Génération et replay sandbox" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Label Content="dx (counts)" />
                                    <TextBox x:Name="GenerateDxTextBox" Text="800" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="dy (counts)" />
                                    <TextBox x:Name="GenerateDyTextBox" Text="-250" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <Label Content="Seed" />
                                    <TextBox x:Name="GenerateSeedTextBox" Text="42" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Label Content="Mode de génération" />
                                    <ComboBox x:Name="GenerationModeComboBox" SelectedIndex="0">
                                        <ComboBoxItem Content="Diffusion — modèle entraîné" Tag="diffusion" />
                                        <ComboBoxItem Content="Baseline — droite minimum-jerk" Tag="baseline" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Label Content="Artefact du modèle (requis pour diffusion)" Margin="0,8,0,0" />
                            <TextBox x:Name="ArtifactPathTextBox" Text="artifacts/latest" />
                            <Button x:Name="GenerateButton" Content="Générer et rejouer" Background="#315F9C" Margin="0,12,0,0" Click="Generate_Click" />
                            <TextBlock x:Name="GenerationStatusText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="FooterPanel" Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="DroppedPacketText" DockPanel.Dock="Right" Text="File Raw Input : 0 en attente · 0 perte" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock x:Name="FooterStatusText" Text="Démarrage…" Foreground="{StaticResource MutedTextBrush}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
